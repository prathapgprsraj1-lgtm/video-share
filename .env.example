# ConnectRoom Environment Configuration

# Server Port
PORT=3001

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Secret used for anonymous session tokens
SESSION_SECRET=connectroom_super_secure_random_session_secret_32chars

# Database (Default: Embedded SQLite via node:sqlite with zero external dependencies)
# For Supabase / PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/connectroom
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LiveKit SFU (Optional - built-in WebRTC mesh over Socket.io signaling works 100% out of the box locally!)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret

# Tenor / GIPHY API (Optional - built-in rich trending GIF categories work out of the box!)
# TENOR_API_KEY=your-tenor-api-key
